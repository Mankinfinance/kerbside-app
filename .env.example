# Which payment backend to use: "fake" (local test stand-in) or "square".
GATEWAY=fake

# Square (only when GATEWAY=square). Never commit real values.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
# SQUARE_VERSION=2025-01-23

PORT=3000
HOST=127.0.0.1
DB_PATH=data/kerbside.db

# Set to 1 only when running locally over plain http.
INSECURE_COOKIES=0
SESSION_HOURS=12

# Held orders are released to the kitchen after this many minutes without "Leaving now".
HOLD_MAX_MINUTES=60
POINTS_PER_DOLLAR=5

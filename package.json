{
  "name": "kerbside-app",
  "version": "0.1.0",
  "private": true,
  "description": "Kerbside Eatery ordering app: customer web app, staff kerbside screen and API on top of Square.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/index.js",
